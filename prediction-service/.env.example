# ===== Variables del microservicio de predicción =====

# MySQL
MYSQL_ROOT_PASSWORD=admin123
MYSQL_DATABASE=football_db

# Proveedor LLM (deepseek u openai)
LLM_PROVIDER=deepseek

# DeepSeek — generá tu API key gratis en https://platform.deepseek.com
DEEP_SEEK_API_KEY=tu_api_key_deepseek
DEEP_SEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEP_SEEK_MODEL=deepseek-chat

# OpenAI (solo si usás LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_URL=
OPENAI_MODEL=
