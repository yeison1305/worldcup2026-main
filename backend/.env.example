# ===== Variables de entorno del backend =====

# Puerto del servidor
PORT=3000

# JWT — generá tu propio secreto de al menos 32 caracteres
JWT_SECRET=tu_jwt_secret_aqui_minimo_32_caracteres

# Supabase — pedile a Miguel o creá tu propia instancia gratis en supabase.com
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key

# Email — necesario para notificaciones de partidos en vivo
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password
EMAIL_FROM=World Cup 2026 <noreply@worldcup2026.com>

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Origins permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
